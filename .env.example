# SMTP 邮件通知配置（QQ 邮箱示例）
# 复制本文件为 .env 并填入真实值；.env 已在 .gitignore 中，不会被提交

# 发件人 QQ 邮箱地址
SMTP_USER=your-account@qq.com

# QQ 邮箱授权码（非登录密码），在 QQ 邮箱设置 → 账户 → POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务 中生成
SMTP_PASS=your-authorization-code

# SMTP 服务器（默认 QQ 邮箱）
SMTP_HOST=smtp.qq.com

# SMTP 端口（SSL 默认 465，STARTTLS 通常 587）
SMTP_PORT=465

# 是否使用 SSL（true/false，默认 true）
SMTP_SECURE=true

# 邮件显示的发件人名称
SMTP_FROM_NAME=Klaus

# 发件人邮箱（默认与 SMTP_USER 相同；QQ 邮箱要求 from 必须等于登录账号）
SMTP_FROM_EMAIL=

# 订单通知默认收件人
ORDER_NOTIFY_TO=735801970@qq.com

# MongoDB 连接串（如果使用非本地实例）
# MONGO_URL=mongodb://username:password@host:27017/?authSource=admin

# 后端端口（默认 3001）
# PORT=3001